  m_Script: {fileID: 11500000, guid: dcc7c4643be973949ae6ee7ba56548ec, type: 3}
  m_Name: c596f118-9316-4cbc-a06b-0109edde151d
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 3
  text: "Eu sei dona lua, mas eu amo minha fam\xEDlia e tenho saudade deles"
  children:
