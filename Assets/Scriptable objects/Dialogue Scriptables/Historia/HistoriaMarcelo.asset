  m_Name: 6babc92f-d781-433c-a762-2bc630006fc2
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: Mas antes, uma menina que passava por perto viu a queda.
