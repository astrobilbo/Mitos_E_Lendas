  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "S\xF3 o Melro que tinha uma apar\xEAncia muito bela, com o bico alaranjado
    e penas negras e a f\xEAmea com tons de preto e pardo claro e a garganta esbranqui\xE7ada
    podiam impedir, pois todos queriam ser t\xE3o belos quanto eles"
  children:
  - b4722a51-09e2-455d-a1f2-17148f0c4263
  rect:
    serializedVersion: 2
