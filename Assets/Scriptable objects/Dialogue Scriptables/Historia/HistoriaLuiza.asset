  m_Name: a4963872-e0aa-4d94-a825-97501011993d
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "H\xE1 muito tempo, as tribos dos p\xE1ssaros viviam em paz e harmonia, mas
