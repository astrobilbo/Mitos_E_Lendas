  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "A gritaria da raposa chamou a aten\xE7\xE3o dos donos do campo de cevada,
    que foram at\xE9 l\xE1 e deram uma pedrada fort\xEDssima na cabe\xE7a do camelo,
    que caiu machucado.\r"
