  m_Name: 8cc86735-23fe-4123-a17f-fe29d7c62589
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: " A raposa logo ficou satisfeita, mas o camelo ainda comia. Awan ent\xE3o
    foi at\xE9 o campo de cevada e come\xE7ou a gritar e correr.\r"
  children:
  - 56557301-f23f-4deb-993d-9e8a4d5d685f
  rect:
    serializedVersion: 2
    x: 1421
    y: 13
    width: 200
