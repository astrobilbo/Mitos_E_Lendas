  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "Nesse momento, Awan caiu das costas do camelo e foi levada pelo rio. O camelo
    por sua vez chegou \xE0 outra margem sem problemas. Awan ent\xE3o recebeu uma
    li\xE7\xE3o por sua gaiatice.\r"
  children:
  - 6d1e5917-7aee-4eda-8044-79cc059b821e
  rect:
    serializedVersion: 2
    x: 2941
