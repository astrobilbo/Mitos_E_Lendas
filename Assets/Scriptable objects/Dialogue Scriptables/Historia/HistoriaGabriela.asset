  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 2
  text: " Ol\xE1, amigo! Eu sei que voc\xEA gosta muito de cevada e se voc\xEA me
    levar nas suas costas eu te mostro um caminho!\r"
  children:
