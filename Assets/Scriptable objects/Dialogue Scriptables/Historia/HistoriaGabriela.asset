  m_Name: 3925a394-a97a-447f-b236-4a1eb318bee2
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 2
  text: "Eu tenho a mania de correr e gritar depois que como lagartixas! Vamos logo
    antes que nos peguem aqui!\r"
  children:
  - 115eb2e5-c418-4423-9893-5965cb5d4f32
  rect:
