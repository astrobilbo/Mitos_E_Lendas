  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcc7c4643be973949ae6ee7ba56548ec, type: 3}
  m_Name: 8fa685ba-5951-48ea-ac9a-b988a37f62fb
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 1
  text: "Err\u2026 Ent\xE3o, essa hist\xF3ria come\xE7a com um sapinho feliz andando
    pelo mato, a maioria dos sapos s\xE3o bem feios, mas esse era realmente muito
    lindo porque ele tamb\xE9m tinha \xF3culos! Ele achou algo estranho no ch\xE3o
    e acreditem se quiser, era uma cobra!\r"
