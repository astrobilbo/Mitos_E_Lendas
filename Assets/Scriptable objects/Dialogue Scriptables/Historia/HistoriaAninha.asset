  m_Name: 41c247a3-7b68-426d-84cd-d3c6a84a06c8
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 5
  text: "Voc\xEA devia saber que a fam\xEDlia da cobra n\xE3o \xE9 legal. Eles s\xE3o
    venenosos! N\xE3o quero mais que brinque com cobras e nem rasteje por a\xED!"
  children:
  - a2ead22f-2214-4be9-ae8b-7fcaaeec8a7d
  rect:
    serializedVersion: 2
    x: 2645
    y: 17
    width: 200
    height: 100
