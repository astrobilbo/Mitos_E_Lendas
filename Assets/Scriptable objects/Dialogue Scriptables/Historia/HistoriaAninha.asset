  onExitAction: 
--- !u!114 &8465082769280902436
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcc7c4643be973949ae6ee7ba56548ec, type: 3}
  m_Name: d6a1dbdb-07fa-4f62-b4d6-adf6cec4bb74
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 6
  text: "N\xF3s cobras n\xE3o temos amizade com sapos, eles servem apenas como comida.
    N\xE3o quero que brinque com o sapo. E pare de pular!"
  children:
  - 32f102a8-2bf3-4302-a296-5d815cd67fde
