  m_Script: {fileID: 11500000, guid: dcc7c4643be973949ae6ee7ba56548ec, type: 3}
  m_Name: 32f102a8-2bf3-4302-a296-5d815cd67fde
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 1
  text: "No dia seguinte quando eles se encontraram, a Cobrinha pensou em comer o
    sapo, mas ela se lembrou das brincadeiras e elogios que tiveram e acabou deixando
    pra l\xE1. Eles n\xE3o brincaram de novo, mas sempre que v\xE3o pegar sol eles
    pensam sobre o dia que foram amigos! \r"
  children:
  - 3b03f451-a2d1-4d54-98ba-c3ab45ddcfff
  rect:
    serializedVersion: 2
    x: 3248
    y: 19
    width: 200
    height: 100
