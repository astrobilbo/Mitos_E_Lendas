  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 1
  text: "A cobra ensinou o sapo a rastejar e subir nas \xE1rvores e o sapo ensinou
    a cobra a pular. Eles se divertiram muito, mas j\xE1 estava ficando tarde e tinham
    que voltar para casa para que seus pais n\xE3o brigassem, mas eles prometeram
    se encontrar no dia seguinte!\r\nMas a\xED\u2026\r"
  children:
  - f48a91a8-5dc2-447e-a3aa-560fcd8a6d86
  rect:
    serializedVersion: 2
    x: 1816
    y: 16
    width: 200
