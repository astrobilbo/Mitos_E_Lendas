  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 1
  text: "Bom dia crian\xE7as, tudo bem com voc\xEAs? Eu sou um estudioso chamado
    Antrop\xF3logo, conversei com seus pais e quero fazer um estudo com voc\xEAs
    sobre \u201CValores Fundamentais\u201D e para isso, queria fazer uma brincadeira
    com voc\xEAs, voc\xEAs aceitam?\r"
