  m_Name: a04626cf-053a-4416-a607-f6bd3c290f67
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 1
  text: "Kenta, Agora sua vez de vir at\xE9 aqui e contar a todos da hist\xF3ria
