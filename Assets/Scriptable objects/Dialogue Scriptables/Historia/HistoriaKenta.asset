  m_Name: 9ce131e2-0a3d-4590-b606-c895bf581b2a
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "Dattebayo! Um dia, contarei pra voc\xEAs sobre um Samurai chamado Yasuke,
    mas hoje, falarei sobre a lenda da Girafa e do Rinoceronte!"
  children:
  - f9add4f2-96a7-479c-84c0-556433fc46e6
  rect:
    serializedVersion: 2
    x: 203
    y: 0
    width: 200
