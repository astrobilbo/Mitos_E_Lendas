  m_Script: {fileID: 11500000, guid: dcc7c4643be973949ae6ee7ba56548ec, type: 3}
  m_Name: 83bd9ff0-6562-4b11-875d-3d62667111ff
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "O feiticeiro ofereceu o feiti\xE7o apenas \xE0 girafa e sumiu. A girafa
    comeu a po\xE7\xE3o m\xE1gica e logo come\xE7ou a sentir suas pernas e pesco\xE7o
    alongando-se."
  children:
  - 17b0aa33-4036-4123-b3c2-02f5bd22deed
  rect:
    serializedVersion: 2
    x: 2387
    y: 19
    width: 200
    height: 100
  onEnterAction: 
  onExitAction: 
--- !u!114 &-5380675324166221970
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
