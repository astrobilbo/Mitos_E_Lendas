  m_Name: 75d2a649-ba6c-42a0-992f-932e73c299ba
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: " No outro dia, a girafa foi at\xE9 a casa do feiticeiro, mas o rinoceronte
    n\xE3o compareceu pois estava muito feliz comendo algumas ervas que tinha encontrado
    pelo caminho."
  children:
  - 83bd9ff0-6562-4b11-875d-3d62667111ff
  rect:
    serializedVersion: 2
    x: 2165
    y: 13
    width: 200
    height: 100
  onEnterAction: 
  onExitAction: 
--- !u!114 &-7309731983139258249
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
