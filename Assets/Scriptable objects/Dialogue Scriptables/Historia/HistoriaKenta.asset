  m_Script: {fileID: 11500000, guid: dcc7c4643be973949ae6ee7ba56548ec, type: 3}
  m_Name: d961bc0e-5cf6-43aa-9371-42ea79f89502
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "At\xE9 que houve um per\xEDodo de seca terr\xEDvel, em que os animais j\xE1
    haviam comido todas as ervas rasteiras e precisavam andar muito para conseguir
    beber \xE1gua."
  children:
  - f10e617c-3d82-411c-96fe-67a484880ab4
  rect:
    serializedVersion: 2
    x: 597
    y: 0
    width: 200
    height: 100
  onEnterAction: 
  onExitAction: 
--- !u!114 &-6247683097759647921
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
