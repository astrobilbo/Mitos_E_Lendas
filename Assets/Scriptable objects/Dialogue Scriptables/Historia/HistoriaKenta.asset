  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "O feiticeiro disse que isso seria muito f\xE1cil e pediu para que ambos
    voltassem no dia seguinte para que ele lhes desse uma po\xE7\xE3o a fim de que
    seus pesco\xE7os e pernas crescessem e pudessem alcan\xE7arem as folhas macias
    da ac\xE1cias.\r"
  children:
