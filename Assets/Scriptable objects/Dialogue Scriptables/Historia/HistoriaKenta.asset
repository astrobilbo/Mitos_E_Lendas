  m_Name: 44ddaec9-18a6-4d4c-90f6-3f2f681e3b54
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  characterSpeaking: 0
  text: "A girafa adorou a ideia e eles foram at\xE9 a casa do feiticeiro explicar
    o que gostariam."
  children:
  - e8b62b42-6723-4b9e-ae34-205fd3a8ed9e
